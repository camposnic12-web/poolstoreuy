# Copiá este archivo a .env para desarrollo local (netlify dev). NUNCA subas .env al repo.
# En Netlify se cargan en: Project configuration → Environment variables (ver README_PAGOS.md).

# Mercado Pago — Tus integraciones → tu aplicación → Credenciales.
# Para pruebas: Access Token de PRUEBA (o el de producción del VENDEDOR de prueba), empieza con APP_USR- o TEST-.
MP_ACCESS_TOKEN=

# Mercado Pago — Tus integraciones → tu aplicación → Webhooks → "Clave secreta".
MP_WEBHOOK_SECRET=

# Opcional: "enforce" (por defecto) rechaza con 401 las firmas inválidas.
# "log" solo las registra y sigue (útil para diagnosticar la primera prueba).
MP_WEBHOOK_SIGNATURE_MODE=

# Resend — API Keys (permiso "Sending access").
RESEND_API_KEY=

# A quién le llega el aviso de venta (se pueden poner varios separados por coma).
ADMIN_EMAIL=

# Remitente. Debe ser de un dominio verificado en Resend, ej: "Pool Store <ventas@poolstore.uy>".
FROM_EMAIL=

# URL pública del sitio, sin barra final. En local: la URL del túnel (https://xxxx.trycloudflare.com).
SITE_URL=https://poolstore.uy
